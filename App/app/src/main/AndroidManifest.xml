<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The renderer is GLES 3.0. Required, not optional: there is no
         fallback path and there never will be. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- The game is played with touch, and also supports gamepads. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!-- singleInstance and the configChanges list are SDL's requirements:
             SDL keeps its own GL surface across rotations and folds rather
             than letting Android recreate the activity under it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:launchMode="singleInstance"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share films: the file the game wrote, read by the app the share
             sheet's chosen, under the grant the share intent carries. -->
        <provider
            android:name=".FilmProvider"
            android:authorities="${applicationId}.films"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
