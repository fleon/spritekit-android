<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later always open on a splash screen of their own,
         by default the launcher icon on the theme's background. The game
         starts as it does on iOS instead: a plain black screen (the launch
         storyboard) until its own first frame, LaunchSplashScene, shows
         Fleon Labs' logo. So the splash is black with no icon in it: its icon
         slot holds a transparent drawable, as showing the launcher icon there
         would put a second, different splash before the game's own. It goes
         once the window draws, onto the same black (windowBackground), which
         stays behind the game's surface until SDL's first frame. -->
    <style name="AppTheme" parent="Base.AppTheme">
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_no_icon</item>
    </style>
</resources>
