# Everything the build scripts fetch or produce. None of it is checked in:
# Scripts/build-sdl.sh, Vendor/build.sh and Scripts/build-shell.sh are the
# source of truth for what ends up in a game's APK.

# Pinned SDL checkout, FreeType and HarfBuzz, and their per-ABI builds.
Vendor/*
!Vendor/.gitignore
!Vendor/README.md
!Vendor/build.sh
!Vendor/versions.sh

.build/
.swiftpm/
*/.build/
*/.swiftpm/
