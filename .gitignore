# Everything the build scripts fetch or produce. None of it is checked in:
# Scripts/build-sdl.sh, Vendor/build.sh and Scripts/build-shell.sh are the
# source of truth for what ends up in a game's APK.

# Pinned SDL checkout, FreeType and HarfBuzz, and their per-ABI builds.
Vendor/*
!Vendor/.gitignore
!Vendor/README.md
!Vendor/build.sh
!Vendor/versions.sh

.build/
.swiftpm/
*/.build/
*/.swiftpm/
# SwiftPM's lockfile for Platform/, a library: each game's own resolution
# decides the swift-syntax it builds with, so this one is never committed.
Platform/Package.resolved

# Arm's ASTC encoder, fetched and built by Tools/Art/ASTC/build-astcenc.sh.
Tools/Art/ASTC/src/
Tools/Art/ASTC/out/

# The Android library's own Gradle build (Library/), when checked on its own.
Library/.gradle/
Library/.kotlin/
Library/build/
Library/local.properties

# Bytecode Python leaves beside Tools/Pricing when a game runs it.
__pycache__/
